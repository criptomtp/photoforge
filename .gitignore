# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ── secrets safety net — credential files must NEVER be committed ──
*.key
*.p12
*.pfx
secrets.txt
passwords.txt
credentials.json
*-key.json
service-account*.json
make-blueprint.json
*vertex*.json
project-*.json
*.iam.gserviceaccount.com.json
*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].json

# working data spreadsheets often carry pasted secrets (this one had OAuth keys)
*.xlsx
/Normalized data photo.xlsx

# local agent / CLI tooling (not part of the app)
.claude/
.claude-flow/
.swarm/
.mcp.json
/supabase/.temp/
/supabase/APPLY_IN_SUPABASE.sql
